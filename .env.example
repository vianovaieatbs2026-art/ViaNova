# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# SERVICIO DE ENVÍO DE CORREOS / EMAIL DELIVERY (Códigos de verificación OTP)
# Configura una de las siguientes opciones para el envío de correos reales:
# ==============================================================================

# Opción 1: Resend (Recomendado - Crea tu API Key gratuita en https://resend.com)
RESEND_API_KEY=""
VITE_RESEND_API_KEY=""

# Opción 2: Servidor SMTP propio (Gmail, Outlook, cPanel, Amazon SES, Brevo)
# Para Gmail: usa una "Contraseña de Aplicación" de 16 caracteres de Google Account
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE=false

# Opción 3: SendGrid (Crea tu API Key en https://sendgrid.com)
SENDGRID_API_KEY=""
VITE_SENDGRID_API_KEY=""

# Opción 4: Brevo / Sendinblue (API Key en https://brevo.com)
BREVO_API_KEY=""

# Opción 5: EmailJS (Envío directo desde navegador en recuperación de contraseña)
VITE_EMAILJS_PUBLIC_KEY="TU_PUBLIC_KEY_AQUI"
VITE_EMAILJS_SERVICE_ID="TU_SERVICE_ID"
VITE_EMAILJS_TEMPLATE_ID="TU_TEMPLATE_ID"

# Dirección de correo remitente verificada (ejemplo: soporte@vianova.co o onboarding@resend.dev para pruebas con Resend)
EMAIL_FROM="ViaNova Colombia <onboarding@resend.dev>"
VITE_EMAIL_FROM="ViaNova Colombia <onboarding@resend.dev>"

# ==============================================================================
# FIREBASE AUTHENTICATION (Opcional si deseas sobrescribir la configuración en Vercel)
# ==============================================================================
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

